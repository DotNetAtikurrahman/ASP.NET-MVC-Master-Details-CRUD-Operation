<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - MollahThaiGlassHouse</title>
    <link rel="shortcut icon" href="~/Images/Screenshot 2026-03-11 214801.png" type="image/x-icon" />
    <link href="~/Content/font-awesome.css" rel="stylesheet" />
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-dark sticky-top" style="background-color: #003366; border-bottom: 3px solid #ffcc00;">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="@Url.Action("Index", "Home")">
                <img src="~/Images/logo.png" alt="Mollah Thai Glass Logo"
                     style="height: 50px; width: auto;" class="me-2 d-inline-block align-top shadow-sm" />
                <div class="d-none d-lg-block">
                    <span class="fw-bold" style="font-size: 1.2rem; letter-spacing: 1px;">MOLLAH</span><br />
                    <small style="font-size: 0.7rem; color: #ffcc00; text-transform: uppercase;">Thai Glass House</small>
                </div>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto fw-bold">
                    <li class="nav-item">@Html.ActionLink("Home", "Index", "Home", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Products", "Index", "Products", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Customers", "Index", "Customers", null, new { @class = "nav-link" })</li>
                </ul>
                @Html.Partial("_LoginPartial")
            </div>
        </div>
    </nav>
               
            

    <div class="container p-0">
        @RenderBody()
    </div>

    <footer class="mt-5 py-4 text-white" style="background-color: #1a1a1a;">
        <div class="container text-center">
            <div class="row">
                <div class="col-md-4">
                    <h5><i class="fa fa-truck me-2"></i>Delivery</h5>
                    <p>Safe delivery within 24-48 hours across Pabna </p>
                </div>
                <div class="col-md-4 border-start border-end">
                    <h5><i class="fa fa-phone me-2"></i>Contact</h5>
                    <p>Call: +880 1321335573<br />Email: info@mollahglass.com</p>
                </div>
                <div class="col-md-4">
                    <h5>Follow Us</h5>
                    <i class="fa fa-facebook fa-2x mx-2"></i>
                    <i class="fa fa-whatsapp fa-2x mx-2"></i>
                    <i class="fa fa-youtube fa-2x mx-2"></i>

                </div>
            </div>
            <hr />
            <p>&copy; @DateTime.Now.Year - Mollah Thai Glass House | Crafted by Atikur</p>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

    <script>
    $("#btnPlus").click(function (myfunc) {
        myfunc.preventDefault();
        var spotContainer = $("#spotContainer");
        $.ajax({
            url: "/Customers/AddNewProduct",
            type: "GET",
            success: function (data) {
                spotContainer.append(data);
            }
        });
    });
    $(document).on("click", "#btnDelete", function (myparameter) {
        myparameter.preventDefault();
        $(this).parent().parent().remove();
    })
    </script>
</body>
</html>
